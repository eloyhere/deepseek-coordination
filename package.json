{
  "name": "deepseek-coordination",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Cross-platform atomic OS-interaction surface for the DeepSeek Harness: one argument-stable verb set implemented natively on each OS, with byte-exact charset, BOM and line-ending handling.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "automation",
    "windows",
    "posix",
    "utf-8",
    "bom",
    "atomic",
    "cli"
  ],
  "license": "MIT",
  "author": "Eloy Kim <eloy.kim@outlook.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eloyhere/deepseek-coordination.git"
  },
  "bugs": {
    "url": "https://github.com/eloyhere/deepseek-coordination/issues"
  },
  "homepage": "https://github.com/eloyhere/deepseek-coordination#readme",
  "engines": {
    "node": ">=18"
  },
  "os": [
    "win32",
    "linux",
    "darwin"
  ],
  "main": "src/plugin/index.js",
  "exports": {
    ".": "./src/plugin/index.js",
    "./permission": "./src/permission/index.js",
    "./package.json": "./package.json"
  },
  "meta": {
    "title": "DSH OS",
    "description": "Atomic cross-platform OS interaction surface: file, environment, task, service, system and permission verbs, each returning one agent-parseable JSON envelope."
  },
  "bin": {
    "dsh-os": "src/host/bin/dsh-os.bat"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "src/host/bin/dsh-os.ps1",
    "src/host/bin/dsh-os.bat",
    "src/host/bin/dsh-os.sh",
    "src/host/command.txt",
    "src/host/spec/verbs.tsv",
    "src/host/spec/charsets.tsv",
    "src/host/docs/os-spec.md",
    "src/host/docs/permission-model.md",
    "src/host/docs/command-original.txt",
    "cordis.patch.yml",
    "src/plugin/index.js",
    "src/permission/index.js",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "os": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File src/host/bin/dsh-os.ps1",
    "test": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File tests/golden.ps1",
    "test:encoding": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File tests/encoding.ps1",
    "test:plugin": "node tests/plugin.test.mjs",
    "test:permission": "node tests/permission.test.mjs",
    "test:bundle": "node tools/verify-bundle.mjs",
    "test:desktop": "bash tests/smoke-desktop-sh.sh",
    "test:load": "node tools/verify-plugin-load.mjs && node tools/verify-editions.mjs",
    "test:all": "npm run test:encoding && npm run test && npm run test:plugin && npm run test:permission && npm run test:bundle && npm run test:load && npm run test:desktop",
    "selfcheck": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File src/host/bin/dsh-os.ps1 selfcheck"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
