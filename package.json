{
  "name": "deepseek-coordination",
  "version": "0.24.3",
  "description": "Attention Manifest Protocol (AMP 0.7.9) host for DeepSeek Harness: fifteen agent modules, a discovery surface, an executable kernel, notification surfaces and read-only AMP panels.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "amp",
    "attention-manifest-protocol",
    "agent-coordination"
  ],
  "license": "Apache-2.0",
  "author": "Eloy Kim <eloy.kim@outlook.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eloyhere/deepseek-coordination.git"
  },
  "bugs": {
    "url": "https://github.com/eloyhere/deepseek-coordination/issues"
  },
  "homepage": "https://github.com/eloyhere/deepseek-coordination#readme",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/eloyhere"
  },
  "type": "module",
  "packageManager": "npm@11.19.0",
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./compaction-backend": {
      "types": "./lib/compaction-backend.d.mts",
      "default": "./lib/compaction-backend.mjs"
    },
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.mjs",
    "lib/index.d.mts",
    "lib/compaction-backend.mjs",
    "lib/compaction-backend.d.mts",
    "lib/client.js",
    "cordis.patch.yml",
    "wire.md",
    "locale/*.json",
    "icon.svg",
    "NOTICE",
    "scripts/migrateStore.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/smoke.test.mjs test/handlers.test.mjs test/client.test.mjs test/sync.test.mjs test/catalog.test.mjs test/vcsignore.test.mjs test/persistence.test.mjs test/dialogGate.test.mjs test/providerContextCompat.test.mjs test/search.test.mjs test/preferences.test.mjs test/ampData.test.mjs test/wireFoundation.test.mjs test/channelsInput.test.mjs test/outputChannels.test.mjs test/lineage.test.mjs test/promptVariables.test.mjs test/recovery.test.mjs test/tombstones.test.mjs test/syncCoverage.test.mjs test/diagnostics.test.mjs test/faultInjection.test.mjs test/release.test.mjs test/clientIntegration.test.mjs",
    "prepack": "npm run build",
    "test:dialogs:browser": "node test/browser/dialogs.browser.mjs",
    "pack:check": "node scripts/checkPack.mjs"
  },
  "engines": {
    "node": ">=24.0.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.1",
    "@deepseek-ai/dsh-compaction": "0.2.2-rc.1",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "0.2.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-output-retention": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.1",
    "@deepseek-ai/dsh-spill": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subagent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-util-values": "0.2.2-rc.1",
    "@types/node": "^26.2.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "attention-manifest-protocol": "0.7.9",
    "react-dom": "^18.2.0"
  }
}
