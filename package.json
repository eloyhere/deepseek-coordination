{
  "name": "deepseek-coordination",
  "version": "0.22.4",
  "description": "A dual-face Cordis plugin for DeepSeek Harness: the host half owns a coordination SQLite database, seven model-facing tools and an HTTP surface; the web half mounts five composer dropdowns, a settings catalog and the service-level takeover dialog.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "plugin",
    "bundle",
    "settings-ui"
  ],
  "license": "Apache-2.0",
  "author": "Eloy Kim <eloy.kim@outlook.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eloyhere/deepseek-coordination.git"
  },
  "bugs": {
    "url": "https://github.com/eloyhere/deepseek-coordination/issues"
  },
  "homepage": "https://github.com/eloyhere/deepseek-coordination#readme",
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.mjs",
    "lib/index.d.mts",
    "lib/client.js",
    "cordis.patch.yml",
    "NOTICE",
    "docs/amp-conformance.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:tsc": "tsc -p tsconfig.test.json --noEmit",
    "test:build": "tsdown --config tsdown.test.config.ts",
    "test": "npm run test:build && node --test .tmp/test-build",
    "prepack": "npm run build",
    "pack:check": "node scripts/check-pack.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.7 || >=0.2.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.7 || >=0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.7 || >=0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.7 || >=0.2.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.7 || >=0.2.1-rc.2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.7 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.7",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^26.2.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "dompurify": "^3.4.17",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "katex": "^0.19.0",
    "mammoth": "^1.13.0",
    "prism-react-renderer": "^2.4.1",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  }
}















