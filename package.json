{
  "name": "deepseek-coordination",
  "version": "0.6.3",
  "description": "DeepSeek Harness plugin bundle: a dual-face Cordis plugin with a host route surface and a web settings page.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "plugin",
    "bundle",
    "settings-ui"
  ],
  "license": "MIT",
  "author": "Eloy Kim <eloy.kim@outlook.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eloyhere/deepseek-coordination.git"
  },
  "bugs": {
    "url": "https://github.com/eloyhere/deepseek-coordination/issues"
  },
  "homepage": "https://github.com/eloyhere/deepseek-coordination#readme",
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.mjs",
    "lib/index.d.mts",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.7 || ^0.2.0-rc.0",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.7 || ^0.2.0-rc.0",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.7 || ^0.2.0-rc.0",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.7 || ^0.2.0-rc.0",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.7 || ^0.2.0-rc.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.7 || ^0.2.0-rc.0",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.7 || ^0.2.0-rc.0",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.7 || ^0.2.0-rc.0",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.7 || ^0.2.0-rc.0",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.7 || ^0.2.0-rc.0",
    "@types/node": "^26.2.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0"
  }
}
