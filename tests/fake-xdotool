#!/usr/bin/env bash
# fake-xdotool - a stand-in xdotool that records what it was asked to do.
#
# Why this exists: the POSIX mouse and keyboard verbs inject through xdotool, and this machine has no X
# display at all, so their real effect cannot be observed here. What CAN be verified without a display is
# everything between the verb and the injection: which subcommand is chosen, whether a button NAME was
# translated to the right number, whether a key name was translated to the right keysym spelling, and
# whether the flags are in the right place. Those are exactly the parts that are easy to get wrong and
# invisible in review.
#
# It records each invocation as one line in $FAKE_XDOTOOL_LOG, so a test can assert on the exact
# argument vector. It also PERSISTS THE CURSOR POSITION in $FAKE_XDOTOOL_POS, because the real tool
# does: a verb that moves the cursor and then reads it back would otherwise always see the initial
# position, and the read-back assertion would be vacuous.
set -u

log="${FAKE_XDOTOOL_LOG:-/dev/null}"
pos="${FAKE_XDOTOOL_POS:-}"
printf '%s\n' "$*" >>"$log"

if [ -n "${FAKE_XDOTOOL_FAIL:-}" ]; then
  printf 'fake-xdotool: forced failure\n' >&2
  exit 1
fi

# The position starts at the configured values when there is no state file yet, so a test can set the
# starting point with FAKE_XDOTOOL_X / FAKE_XDOTOOL_Y.
cur_x="${FAKE_XDOTOOL_X:-100}"
cur_y="${FAKE_XDOTOOL_Y:-200}"
if [ -n "$pos" ] && [ -f "$pos" ]; then
  read -r cur_x cur_y <"$pos" 2>/dev/null || true
fi

case "${1:-}" in
  getmouselocation)
    # The real tool prints these three lines under --shell.
    printf 'X=%s\n' "$cur_x"
    printf 'Y=%s\n' "$cur_y"
    printf 'SCREEN=%s\n' "${FAKE_XDOTOOL_SCREEN:-0}"
    ;;
  mousemove)
    # Arguments are `mousemove [--sync] X Y`; the last two are the coordinates.
    for last in "$@"; do :; done
    y="$last"
    prev=""
    for a in "$@"; do
      if [ "$a" = "$y" ]; then x="$prev"; break; fi
      prev="$a"
    done
    if [ -n "$pos" ] && [ -n "${x:-}" ] && [ -n "${y:-}" ]; then
      printf '%s %s\n' "$x" "$y" >"$pos"
    fi
    ;;
  *)
    # Everything else is a command with no output.
    ;;
esac
exit 0
