!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local authorization state. The canonical empty file IS committed (it is the documented initial
# state); only the runtime side effects of an authorization are ignored.
permission.json.bak
.temporary/acl-state.json
